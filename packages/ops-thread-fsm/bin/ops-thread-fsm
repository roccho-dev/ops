#!/usr/bin/env python3
"""CLI wrapper for the ops-thread-fsm controller package.

The implementation lives under ../lib so the binary stays small enough for
artifact transfer while remaining runnable through both:
  python3 -S packages/ops-thread-fsm/bin/ops-thread-fsm ...
  ops-thread-fsm ...
"""
from __future__ import annotations

import pathlib
import sys


def _lib_dir() -> pathlib.Path:
    return pathlib.Path(__file__).resolve().parents[1] / "lib"


def _main(argv: list[str]) -> int:
    lib_dir = _lib_dir()
    if str(lib_dir) not in sys.path:
        sys.path.insert(0, str(lib_dir))

    try:
        from ops_thread_fsm.cli import main
    except ModuleNotFoundError as exc:
        sys.stderr.write(
            "ops-thread-fsm: missing implementation module "
            "ops_thread_fsm.cli under packages/ops-thread-fsm/lib\n"
        )
        sys.stderr.write(f"{exc}\n")
        return 2

    result = main(argv)
    return int(result or 0)


if __name__ == "__main__":
    raise SystemExit(_main(sys.argv[1:]))
