#!/usr/bin/env python3
import sys,json,pathlib
A=sys.argv[1:];C=A[0] if A else ''
def a(k,d=None):return A[A.index(k)+1] if k in A and A.index(k)+1<len(A) else d
def r(p):
 s=pathlib.Path(p).read_text() if p else '{}'
 try:return json.loads(s)
 except Exception:return {'text':s}
def t(x):return x if isinstance(x,str) else '\n'.join(map(t,x.values())) if isinstance(x,dict) else ''
def b(d,*k):return isinstance(d,dict) and any(d.get(x) is True or str(d.get(x,'')).lower() in 'true yes ok pass valid present 1'.split() for x in k)
def p(st):return {'createWorktree':st=='allowed-to-create-worktree','implement':st=='allowed-to-implement','returnArtifact':st=='allowed-to-return-artifact','sendReview':st=='allowed-to-send-review','readyForMergeReview':st=='ready-for-merge-review','mergeReady':st=='merge-ready','canonicalMerge':False,'push':False,'overwrite':False}
def o(c,n,e=[],retry=False,why=None,auto=None):
 d={'kind':'ops-thread-fsm.classification.v1','classification':c,'nextStateKind':n,'evidence':e,'retry':retry,'retryReason':why,'isStreaming':c=='streaming','permissions':p(n),'writes':False,'sends':False,'nextAction':'fail closed if unclear'}
 if auto is not None:d['autoContinue']=auto
 print(json.dumps(d,ensure_ascii=False));return 0 if c in ['accepted-plan','false-blocker','output-candidate','impl-review-pass','merge-review-pass'] else 1
def first(s):return next((x.strip() for x in s.splitlines() if x.strip()),'')
def v(x,y):
 x=x.casefold();y=y.casefold();return x in [y,'verdict: '+y,'verdict='+y,'status: '+y,'status='+y,'result: '+y,'result='+y]
def cls():
 x=r(a('--input'));s=t(x);rk=a('--request-kind','work')
 if x.get('isStreaming') is True:return o('streaming','sleeping-900',['isStreaming:true'])
 if rk in ['impl-review','merge-review']:
  l=first(s);q=rk+'-pass'
  if v(l,q):return o(q,q,[l])
  if 'reject' in s.lower() or 'failed' in s.lower():return o(rk+'-reject','request-sent',[l],True,'review rejected')
  return o(rk+'-pending','request-sent',[],True,'explicit gate verdict required')
 return o('output-candidate','output-materialized') if any(w in s for w in ['BEGIN_B64_FILE','RUN_REPORT','diff --git','MATERIALIZE_MANIFEST']) else o('output-missing','request-sent',[],True,'no materializable output')
def ext(d):
 e=d.get('externalThread',{}) if isinstance(d,dict) else {};need=b(d,'externalThreadWork','externalThreadRequired') or b(e,'work','required','requested')
 return (not need) or ((b(d,'sendConfirmation','externalSendConfirmation') or b(e,'sendConfirmation','sent')) and (b(d,'readback','readbackExists','externalReadback') or b(e,'readback','readbackExists')))
def plan():
 d=r(a('--input'));c=str(d.get('blockerClaim',d.get('claim',d.get('blocker',''))));lo=c.lower()
 if c and b(d,'readbackDisprovesBlocker','readbackContradictsBlocker','readbackProvesClaimFalse'):return o('false-blocker','accepted-plan',[c],auto=False)
 if c and b(d,'blockerEvidence','evidenceSupportsBlocker','readbackSupportsBlocker'):return o('real-blocker','real-blocker',[c],True,'real blocker',False)
 if c and any(x in lo for x in ['not sent','thread not created','not in project','cannot connect']):return o('insufficient-plan','state-requiring-user-gen0-agreement',[c],True,'unsupported blocker claim',False)
 req=['planComplete','localBaseEvidenceValid','successConditionsPresent','failureConditionsPresent','gatesPresent','reportableEvidencePresent'];miss=[x for x in req if not b(d,x)]
 if not ext(d):miss.append('externalThreadSendConfirmationAndReadback')
 if miss:return o('insufficient-plan','insufficient-plan',miss,True,'missing plan evidence',False)
 need=['preAuthorized','noOverwrite','noMerge','noPush','worktreeBranchAbsent'];bad=[x for x in need if not b(d,x)]
 return o('accepted-plan','state-requiring-user-gen0-agreement',bad,auto=False) if bad else o('accepted-plan','state-allowed-to-proceed-without-extra-user-agreement',auto=True)
def ready():
 m=r(a('--delivery'));rows=m.get('rows',[]);ok=m.get('ok') is True and m.get('count',0)>0 and len(rows)==m.get('count') and all(x.get('bytes')==x.get('bytesExpected') and x.get('sha256')==x.get('sha256Expected') for x in rows)
 ok=ok and v(first(t(r(a('--impl-review')))),'impl-review-pass') and r(a('--local-gate')).get('ok') is True and v(first(t(r(a('--merge-review')))),'merge-review-pass') and pathlib.Path(a('--run-report')).read_text().strip()
 print(json.dumps({'kind':'ops-thread-fsm.ready.v1','ready':bool(ok),'stateKind':'merge-ready' if ok else 'not-ready','writes':False,'sends':False}));return 0 if ok else 1
if C=='classify-readback':sys.exit(cls())
if C=='evaluate-plan':sys.exit(plan())
if C=='check-ready':sys.exit(ready())
if C=='next':
 st=a('--state-kind');print(json.dumps({'kind':'ops-thread-fsm.next.v1','stateKind':st,'dryRun':'--dry-run' in A,'writes':False,'sends':False,'permissions':p(st),'nextAction':'sleep 900; then CDP readback' if st=='request-sent' else 'fail closed if unclear'}));sys.exit(0)
if C=='render-prompt':print('Auto-continue only for complete pre-authorized no-overwrite no-merge no-push plans with local base evidence and external-thread send confirmation plus readback. Unsupported blocker claims need evidence. Target ready-for-merge-review, not merge-ready.');sys.exit(0)
if C=='status':print(json.dumps({'kind':'ops-thread-fsm.status.v1'}));sys.exit(0)
print('usage',file=sys.stderr);sys.exit(2)
