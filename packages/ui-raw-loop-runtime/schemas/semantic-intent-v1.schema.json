{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:roccho-dev:ops:semantic-intent:v1",
  "title": "Semantic intent v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "event_id", "topic_id", "kind", "body"],
  "properties": {
    "schema": { "const": "semantic.intent.v1" },
    "event_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$"
    },
    "topic_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$"
    },
    "kind": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,63}$"
    },
    "body": {
      "type": "string",
      "minLength": 1,
      "maxLength": 16384,
      "pattern": "[^ \\t\\r\\n]"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "[^ \\t\\r\\n]"
    }
  }
}
