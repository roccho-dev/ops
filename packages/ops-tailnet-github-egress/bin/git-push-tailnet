#!/usr/bin/env python3
"""Human Git subcommand wrapper for route-gated GitHub pushes.

Installed as git-push-tailnet, so Git exposes it as `git push-tailnet`.
"""

from __future__ import annotations

import argparse
import json
import os
import re
import subprocess
import sys
from typing import Any
from urllib.parse import urlparse


DISABLED_PUSHURL_PREFIXES = ("DISABLED", "DISABLED-use-git-push-tailnet", "no_push", "NO_PUSH")
REPO_ID_RE = re.compile(r"^(?!\.)(?!.*\.\.)(?!.*\.lock$)(?!.*@\{)[A-Za-z0-9._-]+$")


class PushTailnetError(RuntimeError):
    pass


def run(argv: list[str], *, cwd: str | None = None, check: bool = True, capture: bool = True, env: dict[str, str] | None = None) -> subprocess.CompletedProcess[str]:
    result = subprocess.run(
        argv,
        cwd=cwd,
        text=True,
        check=False,
        stdout=subprocess.PIPE if capture else None,
        stderr=subprocess.PIPE if capture else None,
        env=env,
    )
    if check and result.returncode != 0:
        raise PushTailnetError(f"command failed rc={result.returncode}: {' '.join(argv)}\nstdout:\n{result.stdout or ''}\nstderr:\n{result.stderr or ''}")
    return result


def git(repo: str | None, args: list[str], *, check: bool = True) -> str:
    argv = ["git"]
    if repo:
        argv.extend(["-C", repo])
    argv.extend(args)
    return run(argv, check=check).stdout.strip()


def repo_root(start: str | None) -> str:
    return git(start, ["rev-parse", "--show-toplevel"])


def current_branch(repo: str) -> str:
    return git(repo, ["branch", "--show-current"])


def local_head(repo: str, ref: str = "HEAD") -> str:
    return git(repo, ["rev-parse", ref])


def remote_url(repo: str, name: str, kind: str) -> str | None:
    args = ["remote", "get-url"]
    if kind == "push":
        args.append("--push")
    args.append(name)
    result = run(["git", "-C", repo, *args], check=False)
    if result.returncode != 0:
        return None
    value = (result.stdout or "").strip().splitlines()[0] if (result.stdout or "").strip() else None
    return value


def has_remote(repo: str, name: str) -> bool:
    return run(["git", "-C", repo, "remote", "get-url", name], check=False).returncode == 0


def disabled_pushurl(value: str | None) -> bool:
    if value is None:
        return False
    return any(value.startswith(prefix) for prefix in DISABLED_PUSHURL_PREFIXES)


def choose_remote(repo: str, explicit: str | None) -> tuple[str, str]:
    if explicit:
        return explicit, "explicit"
    if has_remote(repo, "tailnet-github"):
        push = remote_url(repo, "tailnet-github", "push")
        fetch = remote_url(repo, "tailnet-github", "fetch")
        return (fetch if disabled_pushurl(push) and fetch else push or fetch or "tailnet-github", "tailnet-github")
    if has_remote(repo, "origin"):
        push = remote_url(repo, "origin", "push")
        fetch = remote_url(repo, "origin", "fetch")
        if disabled_pushurl(push):
            if not fetch:
                raise PushTailnetError("origin pushurl is disabled and origin fetch URL is missing; pass --remote")
            return fetch, "origin-fetch-because-pushurl-disabled"
        return (push or fetch or "origin", "origin")
    raise PushTailnetError("no --remote, no tailnet-github remote, and no origin remote")


def remote_host(remote: str) -> str | None:
    if remote.startswith("git@"):
        rest = remote.split("@", 1)[1]
        return rest.split(":", 1)[0].split("/", 1)[0]
    parsed = urlparse(remote)
    if parsed.scheme:
        return parsed.hostname
    return None


def require_github_remote(remote: str) -> None:
    host = remote_host(remote)
    if host != "github.com":
        raise PushTailnetError(f"refusing non-GitHub remote for tailnet push: {remote}")


def validate_repo_id(repo_id: str) -> None:
    if not repo_id or "/" in repo_id or not REPO_ID_RE.match(repo_id):
        raise PushTailnetError(f"invalid repo-id: {repo_id}")


def validate_branch(branch: str) -> None:
    if not branch or branch.startswith("/") or branch.endswith("/") or ".." in branch or "@{" in branch:
        raise PushTailnetError(f"invalid branch: {branch}")


def parse_refspec(refspec: str) -> tuple[str, str]:
    if ":" not in refspec:
        raise PushTailnetError("refspec must be explicit <src>:<dst> so remote head can be verified")
    src, dst = refspec.split(":", 1)
    if not src or not dst:
        raise PushTailnetError("refspec must include both source and destination")
    return src, dst


def resolve_refspec(repo: str, args: argparse.Namespace) -> tuple[str, str, str]:
    if args.refs_vault:
        if not args.repo_id or not args.branch:
            raise PushTailnetError("--refs-vault requires --repo-id and --branch")
        validate_repo_id(args.repo_id)
        validate_branch(args.branch)
        dst = f"refs/heads/repos/{args.repo_id}/{args.branch}"
        return "HEAD", dst, f"HEAD:{dst}"
    if args.refspec:
        src, dst = parse_refspec(args.refspec)
        return src, dst, args.refspec
    branch = current_branch(repo)
    if not branch:
        raise PushTailnetError("detached HEAD requires an explicit refspec")
    dst = f"refs/heads/{branch}"
    return "HEAD", dst, f"HEAD:{dst}"


def build_low_level_command(repo: str, remote: str, refspec: str, args: argparse.Namespace) -> list[str]:
    return [
        args.egress_bin,
        "push-local",
        "--long-transfer",
        "--repo-dir",
        repo,
        "--remote",
        remote,
        "--refspec",
        refspec,
        "--timeout",
        str(args.timeout),
        "--json",
    ]


def emit_text(resolved: dict[str, Any], low_level: dict[str, Any] | None) -> None:
    if low_level:
        verify = low_level.get("remoteHeadCheck") or {}
        status = "ok" if low_level.get("ok") else "failed"
        print(
            f"git push-tailnet {status}: "
            f"localHead={resolved.get('localHead')} "
            f"dstRef={resolved.get('dstRef')} "
            f"remoteHead={verify.get('remoteHead')}"
        )
    else:
        print(
            "git push-tailnet dry-run: "
            + " ".join(resolved["command"])
            + f" localHead={resolved.get('localHead')} dstRef={resolved.get('dstRef')}"
        )


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(prog="git push-tailnet")
    parser.add_argument("refspec", nargs="?", help="explicit <src>:<dst> refspec")
    parser.add_argument("--repo-dir", default=".", help="repository directory; default current directory")
    parser.add_argument("--remote", help="GitHub remote URL; defaults to tailnet-github or origin fetch URL")
    parser.add_argument("--refs-vault", action="store_true", help="push to refs/heads/repos/<repoId>/<branch>")
    parser.add_argument("--repo-id", help="refs-vault repoId")
    parser.add_argument("--branch", help="refs-vault branch")
    parser.add_argument("--timeout", type=int, default=600)
    parser.add_argument("--egress-bin", default=os.environ.get("OPS_TAILNET_GITHUB_EGRESS_BIN", "ops-tailnet-github-egress"))
    parser.add_argument("--dry-run", action="store_true", help="resolve defaults and print low-level command without pushing")
    parser.add_argument("--json", action="store_true")
    args = parser.parse_args(argv)

    try:
        repo = repo_root(args.repo_dir)
        remote, remote_source = choose_remote(repo, args.remote)
        require_github_remote(remote)
        src_ref, dst_ref, refspec = resolve_refspec(repo, args)
        local_sha = local_head(repo, src_ref)
        command = build_low_level_command(repo, remote, refspec, args)
        resolved = {
            "schema": "git-push-tailnet.resolved.v1",
            "repoDir": repo,
            "remote": remote,
            "remoteSource": remote_source,
            "srcRef": src_ref,
            "dstRef": dst_ref,
            "refspec": refspec,
            "localHead": local_sha,
            "command": command,
        }
        if args.dry_run:
            report = {"ok": True, "dryRun": True, **resolved}
            if args.json:
                print(json.dumps(report, ensure_ascii=False, indent=2, sort_keys=True))
            else:
                emit_text(report, None)
            return 0

        result = run(command, check=False)
        parsed: dict[str, Any] | None = None
        try:
            parsed = json.loads(result.stdout or "{}")
        except json.JSONDecodeError:
            parsed = None
        if args.json:
            print(json.dumps({"ok": result.returncode == 0 and bool(parsed and parsed.get("ok")), "resolved": resolved, "lowLevel": parsed, "stdout": result.stdout, "stderr": result.stderr, "rc": result.returncode}, ensure_ascii=False, indent=2, sort_keys=True))
        else:
            if parsed is not None:
                emit_text(resolved, parsed)
            else:
                sys.stdout.write(result.stdout or "")
                sys.stderr.write(result.stderr or "")
        return 0 if result.returncode == 0 and parsed and parsed.get("ok") else 1
    except PushTailnetError as exc:
        report = {"ok": False, "error": str(exc)}
        if args.json:
            print(json.dumps(report, ensure_ascii=False, indent=2, sort_keys=True))
        else:
            print(f"git push-tailnet failed: {exc}", file=sys.stderr)
        return 2


if __name__ == "__main__":
    raise SystemExit(main())
