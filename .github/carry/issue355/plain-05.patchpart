+export function packageInventory(repoRoot) {
+  const rows = readJsonl(path.join(repoRoot, "build", "packages.jsonl"));
+  const out = new Map();
+  for (const row of rows) {
+    if (row.kind !== "package" || typeof row.name !== "string") continue;
+    if (out.has(row.name)) throw Error(`package-inventory:duplicate:${row.name}`);
+    out.set(row.name, row);
+  }
+  return out;
+}
+export function compileCatalog({ repoRoot, sourceDir, outDir, sourceCommit = "unknown", sourceSnapshotNarHash = "unknown" }) {
