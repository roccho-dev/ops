diff --git a/packages/ops-operation-catalog/tests/e2e.mjs b/packages/ops-operation-catalog/tests/e2e.mjs
new file mode 100755
index 0000000..cc61033
--- /dev/null
+++ b/packages/ops-operation-catalog/tests/e2e.mjs
@@ -0,0 +1,21 @@
+#!/usr/bin/env node
+import assert from "node:assert/strict";
+import path from "node:path";
+import { fileURLToPath } from "node:url";
+import { runSelftest } from "../lib/selftest.mjs";
+
+const here = path.dirname(fileURLToPath(import.meta.url));
+const packageRoot = path.resolve(here, "..");
+const repoRoot = path.resolve(packageRoot, "../..");
+const result = runSelftest({ repoRoot, packageRoot });
+assert.equal(result.ok, true);
+assert.equal(result.selectedOperations, 12);
+assert.equal(result.unselectedOperations, 1);
+for (const name of ["malformed","duplicate","orphan","unknown-kind","missing-package","missing-obligation","digest-drift"]) assert.equal(result.negative[name], true, name);
+assert.equal(result.deterministicCatalog, true);
+assert.equal(result.deterministicManifest, true);
+assert.equal(result.unselectedCatalogStable, true);
+assert.equal(result.selectedExtensionDelta, 1);
+assert.equal(result.editsProjectionRows, 12);
+assert.equal(result.editsRejectedRows, 0);
+process.stdout.write("ops-operation-catalog: strict deterministic non-authority catalog PASS\n");
