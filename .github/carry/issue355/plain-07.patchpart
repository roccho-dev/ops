 Object.values(negative).every(Boolean) &&
+      bytesEqual(path.join(outA, "operation-catalog.jsonl"), path.join(outB, "operation-catalog.jsonl")) &&
+      bytesEqual(path.join(outA, "manifest.json"), path.join(outB, "manifest.json")) &&
+      first.manifest.catalogDigest === isolation.manifest.catalogDigest &&
+      extension.catalog.length === first.catalog.length + 1 &&
+      editsRejected === 0,
+    selectedOperations: first.catalog.length,
+    unselectedOperations: first.unselectedCount,
+    negative,
+    deterministicCatalog: bytesEqual(path.join(outA, "operation-catalog.jsonl"), path.join(outB, "operation-catalog.jsonl")),
+    deterministicManifest: bytesEqual(path.join(outA, "manifest.json"), path.join(outB, "manifest.json")),
+    unselectedCatalogStable: first.manifest.catalogDigest === isolation.manifest.catalogDigest,
+    selectedExtensionDelta: extension.catalog.length - first.catalog.length,
+    editsProjectionRows: editsProjection.length,
+    editsRejectedRows: editsRejected,
+    firstManifest: first.manifest,
+  };
+}
