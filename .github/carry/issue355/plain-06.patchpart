eSnapshotNarHash !== "string" || !manifest.sourceSnapshotNarHash.startsWith("sha256-")) throw Error("manifest:source-snapshot-nar-hash");
+  if (catalog.length !== manifest.rowCount) throw Error("manifest:row-count");
+  const bytes = fs.readFileSync(path.join(outDir, "operation-catalog.jsonl"));
+  if (digestBytes(bytes) !== manifest.catalogDigest) throw Error("manifest:catalog-digest");
+  const base = { ...manifest }; delete base.manifestDigest;
+  if (objectDigest(base) !== manifest.manifestDigest) throw Error("manifest:self-digest");
+  let previous = "";
+  for (const row of catalog) {
+    const contentDigest = row.contentDigest; const source = { ...row }; delete source.contentDigest;
+    validateOperation(source);
+    if (objectDigest(source) !== contentDigest) throw Error(`catalog:content-digest:${row.operationId}`);
+    const key = `${row.operationId}@${row.operationVersion}`;
+    if (previous && previous.localeCompare(key) >= 0) throw Error("catalog:not-sorted-or-duplicate");
+    previous = key;
+  }
+  return { catalog, manifest };
+}
+export function projectForEdits(row) {
+  const source = { ...row }; delete source.contentDigest; validateOperation(source);
+  return {
+    kind: "ops.operation.shadow.v1",
+    operationId: row.operationId,
+    operationVersion: row.operationVersion,
+    command: row.command,
+    intent: row.intent,
+    target: row.target,
+    risk: "shadow-only",
+    status: "shadow",
+  };
+}
