atalog, validateOutput } from "../lib/core.mjs";
+import { runSelftest } from "../lib/selftest.mjs";
+
+function value(args, name) { const index=args.indexOf(name); if(index<0||index+1>=args.length) throw Error(`missing:${name}`); return args[index+1]; }
+const [command, ...args] = process.argv.slice(2);
+try {
+  if (command === "compile") {
+    const result=compileCatalog({repoRoot:path.resolve(value(args,"--repo-root")),sourceDir:path.resolve(value(args,"--source-dir")),outDir:path.resolve(value(args,"--out-dir")),sourceCommit:value(args,"--source-commit"),sourceSnapshotNarHash:value(args,"--source-snapshot-nar-hash")});
+    process.stdout.write(JSON.stringify({ok:true,rowCount:result.catalog.length,manifestDigest:result.manifest.manifestDigest})+"\n");
+  } else if (command === "validate") {
+    const result=validateOutput(path.resolve(value(args,"--out-dir"))); process.stdout.write(JSON.stringify({ok:true,rowCount:result.catalog.length,manifestDigest:result.manifest.manifestDigest})+"\n");
+  } else if (command === "selftest") {
+    process.stdout.write(JSON.stringify(runSelftest({repoRoot:path.resolve(value(args,"--repo-root")),packageRoot:path.resolve(value(args,"--package-root"))}),null,args.includes("--pretty")?2:0)+"\n");
+  } else throw Error("usage: ops-operation-catalog <compile|validate|selftest>");
+} catch (error) { process.stderr.write(`ops-operation-catalog: ${error.message}\n`); process.exitCode=1; }
diff --git a/packages/ops-operation-catalog/default.nix b/packages/ops-operation-catalog/default.nix
new file mode 100644
index 0000000..21a56ee
--- /dev/null
+++ b/packages/ops-operation-catalog/default.nix
@@ -0,0 +1,22 @@
+{
+  pkgs,
+  sourceCommit,
+  sourceSnapshotNarHash,
+}:
+pkgs.runCommand "ops-operation-catalog-v1"
+  {
+    nativeBuildInputs = [ pkgs.nodejs ];
+  }
+  ''
+    set -euo pipefail
+    mkdir -p "$out"
+    node ${./bin/ops-operation-catalog.mjs} compile \
+      --repo-root ${../..} \
+      --source-dir ${./source} \
+      --out-dir "$out" \
+      --source-commit ${sourceCommit} \
+      --source-snapshot-nar-hash ${sourceSnapshotNarHash}
+    node ${./bin/ops-operation-catalog.mjs} validate --out-dir "$out"
+    test -s "$out/operation-catalog.jsonl"
+    test -s "$out/manifest.json"
+  ''
