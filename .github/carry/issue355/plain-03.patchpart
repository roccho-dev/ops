ta.get("nixCheck"), "PASS")
+        self.assertEqual(data.get("outputReadback"), "PASS")
+        self.assertEqual(data.get("status"), "PASS")
+
+    def test_preexisting_ops_regressions_skips_and_waivers_are_zero(self) -> None:
+        data = load("preexisting-regression.json")
+        self.assertGreater(data.get("suites", 0), 0)
+        self.assertEqual(data.get("failedSuites"), 0)
+        self.assertEqual(data.get("skips"), 0)
+        self.assertEqual(data.get("waivers"), 0)
+        self.assertEqual(data.get("status"), "PASS")
+
+
+if __name__ == "__main__":
+    unittest.main()
diff --git a/proofs/issue-355/run-lane.sh b/proofs/issue-355/run-lane.sh
new file mode 100755
index 0000000..dabf134
--- /dev/null
+++ b/proofs/issue-355/run-lane.sh
@@ -0,0 +1,9 @@
+#!/usr/bin/env bash
+set -euo pipefail
+mode=${1:?usage: run-lane.sh --expect-red|--expect-green lane-dir [result-file]}
+lane=${2:?usage: run-lane.sh --expect-red|--expect-green lane-dir [result-file]}
+result=${3:-}
+args=("$lane" "$mode")
+if [[ -n "$result" ]]; then args+=(--result "$result"); fi
+export PYTHONDONTWRITEBYTECODE=1
+exec python3 "$(dirname "$0")/canon_runner.py" "${args[@]}"
-- 
