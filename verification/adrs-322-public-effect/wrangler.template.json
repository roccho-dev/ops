{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "stg-log-projected-public",
  "main": "src/worker.mjs",
  "compatibility_date": "2026-08-28",
  "workers_dev": true,
  "send_metrics": false,
  "assets": {
    "directory": "public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "r2_buckets": [
    {
      "binding": "OBSERVATIONS",
      "bucket_name": "stg-log-projected-observations"
    }
  ],
  "vars": {
    "APP_VERSION": "GENERATED_CANDIDATE_SHA",
    "WORKER_NAME": "stg-log-projected-public"
  }
}
