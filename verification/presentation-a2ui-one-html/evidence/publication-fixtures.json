  "referenceBody": "{\"a2ui\":[{\"createSurface\":{\"catalogId\":\"urn:roccho:a2ui:catalog:base:1\",\"sendDataModel\":true,\"surfaceId\":\"presentation\"},\"version\":\"v0.9\"},{\"updateDataModel\":{\"path\":\"/\",\"surfaceId\":\"presentation\",\"value\":{\"authority\":false,\"claims\":[\"one-html\",\"a2ui-component-page\",\"renderer-independent-module-target\",\"sandboxed-document-adapter\"],\"schema\":\"presentation-proof-data/2\"}},\"version\":\"v0.9\"},{\"updateComponents\":{\"components\":[{\"children\":[\"intro-kicker\",\"intro-title\",\"intro-body\",\"intro-card\"],\"component\":\"Column\",\"gap\":18,\"id\":\"page-intro\"},{\"component\":\"Text\",\"id\":\"intro-kicker\",\"text\":\"PRESENTATION ARTIFACT PROOF\",\"variant\":\"caption\"},{\"component\":\"Text\",\"id\":\"intro-title\",\"text\":\"One contract. One HTML. Two page targets.\",\"variant\":\"h1\"},{\"component\":\"Text\",\"id\":\"intro-body\",\"text\":\"The deck is carried in #presentation. A page selects either an A2UI component root or a URL module target. There is no Slide component and no renderer inside the page contract.\"},{\"children\":[\"intro-card-title\",\"intro-card-body\"],\"component\":\"Card\",\"id\":\"intro-card\"},{\"component\":\"Text\",\"id\":\"intro-card-title\",\"text\":\"Artifact boundary\",\"variant\":\"h2\"},{\"component\":\"Text\",\"id\":\"intro-card-body\",\"text\":\"Deck meaning → URL transport → page target → A2UI renderer or registered module adapter.\"},{\"children\":[\"contract-kicker\",\"contract-title\",\"contract-card\",\"contract-divider\",\"contract-body\"],\"component\":\"Column\",\"gap\":18,\"id\":\"page-contract\"},{\"component\":\"Text\",\"id\":\"contract-kicker\",\"text\":\"NO RENDERER IN THE PAGE CONTRACT\",\"variant\":\"caption\"},{\"component\":\"Text\",\"id\":\"contract-title\",\"text\":\"A page selects. A module decides how it is shown.\",\"variant\":\"h1\"},{\"children\":[\"contract-card-title\",\"contract-card-body\"],\"component\":\"Card\",\"id\":\"contract-card\"},{\"component\":\"Text\",\"id\":\"contract-card-title\",\"text\":\"url-module\",\"variant\":\"h2\"},{\"component\":\"Text\",\"id\":\"contract-card-body\",\"text\":\"The page carries appId, contractVersion, and href. The manifest fixes source policy, lifecycle, renderer, capabilities, and fallback before display.\"},{\"component\":\"Divider\",\"id\":\"contract-divider\"},{\"component\":\"Text\",\"id\":\"contract-body\",\"text\":\"This proof registers a conforming document contract. Its browser adapter uses a sandboxed iframe and requires an exact ready handshake; presentation code does not depend on iframe.\"},{\"children\":[\"proof-kicker\",\"proof-title\",\"proof-card\",\"proof-next\"],\"component\":\"Column\",\"gap\":18,\"id\":\"page-proof\"},{\"component\":\"Text\",\"id\":\"proof-kicker\",\"text\":\"A2UI CLIENT ACTION\",\"variant\":\"caption\"},{\"component\":\"Text\",\"id\":\"proof-title\",\"text\":\"The component tree does not know navigation code.\",\"variant\":\"h1\"},{\"children\":[\"proof-card-title\",\"proof-card-body\"],\"component\":\"Card\",\"id\":\"proof-card\"},{\"component\":\"Text\",\"id\":\"proof-card-title\",\"text\":\"Observable proof\",\"variant\":\"h2\"},{\"component\":\"Text\",\"id\":\"proof-card-body\",\"text\":\"This trusted Button emits presentation.next. The generic shell selects the next page; the registry selects its trusted adapter and confirms readiness before PASS.\"},{\"action\":\"presentation.next\",\"component\":\"Button\",\"context\":{\"reason\":\"proof\"},\"id\":\"proof-next\",\"label\":\"Open the module →\"}],\"surfaceId\":\"presentation\"},\"version\":\"v0.9\"}],\"pages\":[{\"id\":\"intro\",\"target\":{\"kind\":\"component\",\"rootId\":\"page-intro\"},\"title\":\"One contract, one HTML\"},{\"id\":\"contract\",\"target\":{\"kind\":\"component\",\"rootId\":\"page-contract\"},\"title\":\"Page is only a target\"},{\"id\":\"proof\",\"target\":{\"kind\":\"component\",\"rootId\":\"page-proof\"},\"title\":\"A2UI action is still generic\"},{\"id\":\"module\",\"target\":{\"appId\":\"conforming-document\",\"contractVersion\":\"1\",\"href\":\"https://modules.customer-a.test/proof\",\"kind\":\"url-module\"},\"title\":\"URL module chooses its renderer by manifest\"}],\"schema\":\"presentation-envelope/2\",\"start\":\"intro\",\"title\":\"A2UI + URL Module · One HTML Proof\"}",
