  "externalModuleHtml": "<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">\n<meta http-equiv=\"Content-Security-Policy\" content=\"default-src 'none'; style-src 'unsafe-inline'; script-src 'unsafe-inline'; form-action 'none'; base-uri 'none'\">\n<title>Conforming URL Module Proof</title>\n<style>\n:root{font-family:system-ui,sans-serif;color:#10213d;background:#f4f8ff}*{box-sizing:border-box}body{margin:0;min-height:100vh;display:grid;place-items:center;padding:24px}.card{width:min(680px,100%);padding:clamp(24px,6vw,64px);border:2px solid #91b6e9;border-radius:24px;background:white;box-shadow:0 22px 70px #2e5e9e28}.tag{font-size:.75rem;letter-spacing:.14em;color:#315f9d}.title{font-size:clamp(2rem,7vw,4.2rem);line-height:1;margin:.35em 0}.body{font-size:1.08rem;line-height:1.6;color:#40506a}.counter{display:flex;align-items:center;gap:12px;margin-top:28px}button{min-height:48px;border:0;border-radius:12px;padding:12px 18px;background:#173b72;color:white;font:inherit;font-weight:700}output{font-size:1.4rem;font-weight:800}\n@media(max-width:520px){body{display:block;padding:14px}.card{min-height:calc(100vh - 28px);padding:24px;display:grid;align-content:center}.title{font-size:clamp(2rem,10vw,3rem)}.body{font-size:1rem}.counter{flex-wrap:wrap}}\n</style>\n</head>\n<body>\n<main class=\"card\" data-url-module-proof=\"pass\">\n  <div class=\"tag\">CONFORMING SANDBOXED URL MODULE</div>\n  <h1 class=\"title\">Independent HTML, same presentation.</h1>\n  <p class=\"body\">This document is not converted into A2UI. It implements the registered lifecycle contract, receives an init message through a transferred port, and confirms its exact contract and renderer version before the parent reports PASS.</p>\n  <div class=\"counter\"><button id=\"increment\" type=\"button\">Run module code</button><output id=\"count\">0</output></div>\n</main>\n<script>\nconst identity=Object.freeze({appId:'conforming-document',contractVersion:'1',rendererVersion:'2'});\nwindow.addEventListener('message',event=>{\n  const input=event.data;\n  if(!input||input.schema!=='artifact-module-init/1'||event.ports.length!==1)return;\n  if(input.appId!==identity.appId||input.contractVersion!==identity.contractVersion||input.rendererVersion!==identity.rendererVersion||input.protocol!=='artifact-module-lifecycle/1')return;\n  event.ports[0].postMessage({...identity,schema:'artifact-module-ready/1'});\n});\nconst button=document.getElementById('increment');\nconst output=document.getElementById('count');\nbutton.addEventListener('click',()=>{output.textContent=String(Number(output.textContent)+1)});\n</script>\n</body>\n</html>\n",
