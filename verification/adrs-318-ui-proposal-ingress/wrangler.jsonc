{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "stg-adrs-ui-proposal-ingress",
  "main": "src/worker.mjs",
  "compatibility_date": "2026-08-29",
  "workers_dev": true,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "none",
    "not_found_handling": "single-page-application"
  },
  "r2_buckets": [
    {
      "binding": "PROPOSALS",
      "bucket_name": "stg-adrs-ui-proposals"
    }
  ],
  "vars": {
    "APP_VERSION": "source-default"
  }
}
