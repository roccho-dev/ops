{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ops.decisionClosureReceipt.v1",
  "type": "object",
  "required": ["schema", "status", "authority_root_digest", "records", "engine", "semantic_mismatch_count", "fail_closed_mismatch_count", "negative_case_count", "economics", "human_projection", "incremental_replay", "production_cutover_authorized", "public_release_authorized", "limitations"],
  "properties": {
    "schema": {"const": "ops.decisionClosureProof.v1"},
    "status": {"enum": ["PASS", "HOLD", "BLOCKED"]},
    "authority_root_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "records": {"type": "integer", "minimum": 1},
    "engine": {"enum": ["sqlite-shards", "frozen-ducklake", "hold-jsonl-only"]},
    "semantic_mismatch_count": {"type": "integer", "minimum": 0},
    "fail_closed_mismatch_count": {"type": "integer", "minimum": 0},
    "negative_case_count": {"type": "integer", "minimum": 0},
    "economics": {"type": "string"},
    "human_projection": {"type": "string"},
    "incremental_replay": {"type": "string"},
    "production_cutover_authorized": {"type": "boolean"},
    "public_release_authorized": {"type": "boolean"},
    "limitations": {"type": "array", "items": {"type": "string"}}
  }
}
