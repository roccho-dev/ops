{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ops.decisionPacket.v1",
  "type": "object",
  "required": ["schema", "decision_id", "checkpoint_id", "question", "status", "recommendation", "changed_since_previous", "alternatives", "evidence_for", "evidence_against", "conditions", "conflicts", "gaps", "next_action", "success_conditions", "stop_conditions", "outcomes", "record_refs", "projection_asset_refs", "query_contract_digest", "packet_digest"],
  "properties": {
    "schema": {"const": "ops.decisionPacket.v1"},
    "decision_id": {"type": "string", "minLength": 1},
    "checkpoint_id": {"type": "string", "minLength": 1},
    "question": {"type": "string", "minLength": 1},
    "status": {"type": "string", "minLength": 1},
    "recommendation": {},
    "changed_since_previous": {"type": "array"},
    "alternatives": {"type": "array", "minItems": 1},
    "evidence_for": {"type": "array"},
    "evidence_against": {"type": "array"},
    "conditions": {"type": "array", "items": {"type": "string"}},
    "conflicts": {"type": "array"},
    "gaps": {"type": "array"},
    "next_action": {"type": "string", "minLength": 1},
    "success_conditions": {"type": "array", "minItems": 1},
    "stop_conditions": {"type": "array", "minItems": 1},
    "outcomes": {"type": "array"},
    "record_refs": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "projection_asset_refs": {"type": "array"},
    "query_contract_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "packet_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
